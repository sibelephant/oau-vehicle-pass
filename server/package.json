{
  "name": "oau-vehicle-pass-server",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "node apps/server/dist/index.mjs",
    "check-types": "turbo run check-types",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @oau-vehicle-pass/db --",
    "db:studio": "turbo run db:studio -F @oau-vehicle-pass/db --",
    "db:generate": "turbo run db:generate -F @oau-vehicle-pass/db --",
    "db:migrate": "turbo run db:migrate -F @oau-vehicle-pass/db --",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && npm run auth:generate",
    "db:seed": "cd apps/server && npx tsx src/seed.ts"
  },
  "dependencies": {
    "turbo": "^2.10.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@oau-vehicle-pass/config": "*",
    "@types/node": "^26.4.1",
    "typescript": "^6.0.3",
    "varlock": "1.18.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true
  }
}
